---
import PaperLink from '../components/PaperLink.astro';
import Base from '../layouts/Base.astro';
import { citeAs, loadWiki } from '../lib/wiki';

const wiki = await loadWiki();
// A stub has nothing to put in the table. The stubs are listed with the candidates.
const written = wiki.papers.filter((p) => p.data.status !== 'stub');
const stubs = wiki.papers.length - written.length;
---

<Base title="Papers" path="/papers" description="Every paper with a page in the wiki: what it studies, its methods and its models." wide>
  <h1>Papers</h1>
  <p class="lede">Every paper with a page: what it studies, its methods and its models.</p>
  <div class="scroll">
    <table class="matrix">
      <thead>
        <tr>
          <th>Paper</th>
          <th>Tier</th>
          <th>Reports on</th>
          <th>Methods</th>
          <th>Models</th>
        </tr>
      </thead>
      <tbody>
        {
          written.map((p) => {
            const e = p.data.setup;
            return (
              <tr>
                <td>
                  <PaperLink paper={p}>{citeAs(p)}</PaperLink>
                  <br />
                  <span class="note">{p.data.title}</span>
                </td>
                <td>{p.data.tier}</td>
                {e ? (
                  <Fragment>
                    <td>{e.reports_on}</td>
                    <td>{e.methods.join(', ')}</td>
                    <td>{e.models.join(', ') || 'n/a'}</td>
                  </Fragment>
                ) : (
                  <td colspan="3" class="not-addressed">
                    not recorded
                  </td>
                )}
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  {
    stubs > 0 && (
      <p class="note">
        {stubs} more papers are accepted and waiting for a page. They are listed with the{' '}
        <a href="/candidates#stubs">candidates</a>.
      </p>
    )
  }
</Base>
