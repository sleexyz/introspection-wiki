---
import PaperLink from '../components/PaperLink.astro';
import Base from '../layouts/Base.astro';
import { citeAs, loadWiki } from '../lib/wiki';

const wiki = await loadWiki();
---

<Base title="Papers" path="/papers" description="Every paper page in the wiki: what it studies, its methods and its models." wide>
  <h1>Papers</h1>
  <p class="lede">Every paper page: what it studies, its methods and its models.</p>
  <div class="scroll">
    <table class="matrix">
      <thead>
        <tr>
          <th>Paper</th>
          <th>Tier</th>
          <th>Reports on</th>
          <th>Methods</th>
          <th>Models</th>
        </tr>
      </thead>
      <tbody>
        {
          wiki.papers.map((p) => {
            const e = p.data.setup;
            return (
              <tr>
                <td>
                  <PaperLink paper={p}>{citeAs(p)}</PaperLink>
                  <br />
                  <span class="note">{p.data.title}</span>
                </td>
                <td>{p.data.tier}</td>
                {e ? (
                  <Fragment>
                    <td>{e.reports_on}</td>
                    <td>{e.methods.join(', ')}</td>
                    <td>{e.models.join(', ') || 'n/a'}</td>
                  </Fragment>
                ) : (
                  <td colspan="3" class="not-addressed">
                    stub: no summary yet
                  </td>
                )}
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</Base>
