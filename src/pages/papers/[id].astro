---
import PaperPage from '../../components/PaperPage.astro';
import { loadWiki, type Paper } from '../../lib/wiki';

export async function getStaticPaths() {
  const wiki = await loadWiki();
  return wiki.papers.map((paper) => ({ params: { id: paper.id }, props: { paper } }));
}

const { paper } = Astro.props as { paper: Paper };
---

<PaperPage paper={paper} />
