---
import PaperLink from '../components/PaperLink.astro';
import Base from '../layouts/Base.astro';
import { SITE, TIERS, citeAs, frontier, loadWiki } from '../lib/wiki';

const wiki = await loadWiki();
const stubCount = wiki.papers.filter((p) => p.data.status === 'stub').length;
const headings = [
  ...TIERS.filter(({ tier }) => wiki.papers.some((p) => p.data.tier === tier)).map(({ tier, label }) => ({ depth: 2, slug: tier, text: label })),
  { depth: 2, slug: 'concepts', text: 'Concepts' },
  { depth: 2, slug: 'threads', text: 'Threads' },
  { depth: 2, slug: 'candidates', text: 'Candidates' },
  { depth: 2, slug: 'for-language-models', text: 'For language models' },
];
const jsonld = { '@type': 'WebSite', name: SITE.name, url: SITE.url, description: SITE.description, license: 'https://creativecommons.org/licenses/by/4.0/' };
---

<Base path="/" jsonld={jsonld} headings={headings}>
  <h1>{SITE.name}</h1>
  <p class="lede">
    Papers and resources on introspection in large language models: whether a model can report on its own internal
    states.
  </p>
  <p>
    A self-report counts as introspection here only if it is <a href="/concepts/faithfulness">faithful</a> (it matches
    what the model actually does or represents) and <a href="/concepts/grounding">grounded</a> (it is caused by the
    state it describes, rather than arrived at some other way).
  </p>

  {
    TIERS.map(({ tier, label, blurb }) => {
      const list = wiki.papers.filter((p) => p.data.tier === tier);
      // The papers with a page come first. The stubs of the tier are folded away under them until asked for.
      const stubs = list.filter((p) => p.data.status === 'stub');
      const written = list.filter((p) => p.data.status !== 'stub');
      const count = `${stubs.length} ${stubs.length === 1 ? 'stub' : 'stubs'}`;
      const entries = (papers: typeof list) => (
        <ul class="entries">
          {papers.map((p) => (
            <li>
              <PaperLink paper={p}>{p.data.title}</PaperLink> <span class="meta">{citeAs(p)}</span>
              <span class="desc">{p.data.summary}</span>
            </li>
          ))}
        </ul>
      );
      return (
        list.length > 0 && (
          <section>
            <h2 id={tier}>{label}</h2>
            <p class="note">{blurb}</p>
            {written.length > 0 && entries(written)}
            {stubs.length > 0 && (
              <details class="stubs">
                <summary>
                  <span class="closed">Show {count}</span>
                  <span class="open">Hide {count}</span>
                </summary>
                {entries(stubs)}
              </details>
            )}
          </section>
        )
      );
    })
  }

  <h2 id="concepts">Concepts</h2>
  <ul class="entries">
    {
      wiki.concepts.map((c) => (
        <li>
          <a href={`/concepts/${c.id}`}>{c.data.title}</a>
          <span class="desc">{c.data.summary}</span>
        </li>
      ))
    }
  </ul>

  <h2 id="threads">Threads</h2>
  <ul class="entries">
    {
      wiki.threads.map((t) => (
        <li>
          <a href={`/threads/${t.id}`}>{t.data.title}</a>{' '}
          <span class="meta">@{t.data.author.handle} · {t.data.tweets.length} posts</span>
          <span class="desc">{t.data.summary}</span>
        </li>
      ))
    }
  </ul>

  <h2 id="candidates">Candidates</h2>
  <p>
    The <a href="/candidates">candidates</a> are the papers without a page yet:
    the {stubCount} stubs above, and {frontier.candidates.length} papers that sit one citation away from the wiki and have
    not been added.
  </p>

  <h2 id="for-language-models">For language models</h2>
  <p>
    Every page has a plain-markdown twin at the same URL plus <code>.md</code>, and returns it when asked with
    <code>Accept: text/markdown</code>. <a href="/llms.txt">llms.txt</a> indexes the site;
    <a href="/llms-full.txt">llms-full.txt</a> is all of it in one file. The data is also available as
    <a href="/data/papers.json">papers.json</a>, <a href="/data/graph.json">graph.json</a>,
    <a href="/data/frontier.json">frontier.json</a> and <a href="/references.bib">references.bib</a>.
  </p>
</Base>
