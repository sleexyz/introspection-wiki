---
import '../styles/global.css';
import Toc, { type Heading } from '../components/Toc.astro';
import { SITE } from '../lib/wiki';

interface Props {
  title?: string;
  description?: string;
  /** Site-relative URL of this page, e.g. "/papers/foo". */
  path: string;
  /** schema.org description of the page, emitted as JSON-LD. */
  jsonld?: Record<string, unknown>;
  /** False for pages with no markdown twin (the 404 page). */
  twin?: boolean;
  wide?: boolean;
  /** Sections of the page, for the table of contents. Omit for no contents list. */
  headings?: Heading[];
  /** True when the page embeds posts from X, which need X's widget script. */
  embeds?: boolean;
  /** True when the page shows a paper beside its text (PaperPane.astro). */
  reader?: boolean;
}

const { title, description = SITE.description, path, jsonld, twin = true, wide = false, headings = [], embeds = false, reader = false } = Astro.props;
const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length > 1;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = SITE.url + (path === '/' ? '/' : path);
const markdown = path === '/' ? '/index.md' : `${path}.md`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {twin && <link rel="alternate" type="text/markdown" href={markdown} title="This page as markdown">}
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title={SITE.name}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:title" content={title ?? SITE.name}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="article">
  <meta property="og:url" content={canonical}>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonld })} />}
  {
    /* Make room for the paper before the first paint, so the text does not jump
       when the reader loads. paperLayout sets the pane's width (the reader's
       own choice if they dragged it) and says whether the contents rail still
       fits beside the text. */
    reader && (
      <script is:inline>
        window.paperLayout = function (width) {
          var root = document.documentElement, w = innerWidth;
          var pane = width ? Math.max(380, Math.min(width, w - 440)) : Math.max(460, Math.min(w - (w >= 1620 ? 1012 : 708), 780));
          root.style.setProperty('--pane-w', pane + 'px');
          root.classList.toggle('toc-fits', w - pane >= 1012);
          return pane;
        };
        try {
          var saved = JSON.parse(localStorage.getItem('paper-pane') || '{}');
          if (!saved.hidden) document.documentElement.classList.add('paper-open');
          paperLayout(saved.width);
        } catch (e) {
          document.documentElement.classList.add('paper-open');
          paperLayout();
        }
      </script>
    )
  }
</head>
<body>
  <main class:list={{ wide, 'with-toc': hasToc, reader }}>
    <nav class="site-nav" aria-label="Site">
      <span>
        <a href="/">{SITE.name}</a> &middot;
        <a href="/papers">Papers</a> &middot;
        <a href="/frontier">Frontier</a> &middot;
        <a href="/about">About</a>
      </span>
      <span>
        {twin && <a href={markdown} title="This page as plain markdown">.md</a>}
        {twin && <Fragment>&middot;</Fragment>}
        <a href="/llms.txt">llms.txt</a>
      </span>
    </nav>
    <hr>
    <div class="page">
      <Toc headings={headings} />
      <slot />
    </div>
    <hr class="foot">
    <footer>
      <p>
        Summaries are drafted by an AI model from the sources each page lists, and are marked until a person has
        checked them. <a href="/about">How this wiki is made</a>.
      </p>
      <p>
        Text is <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>; quoted posts, figures and papers
        belong to their authors. <a href={SITE.repo}>Source and corrections on GitHub</a>.
      </p>
    </footer>
  </main>
  {/* Upgrades the embedded posts into X's full embeds. The page reads without it. */}
  {embeds && <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>}
</body>
</html>
