---
// A paper page, whole: the layout around it, the article, and the paper beside
// it where the page is in the outline format. The current page of every paper
// (/papers/<id>) is drawn with this, and so is an earlier version kept in the
// archive (/archive/<id>).
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getAnchors } from '../lib/anchors';
import { citeHtml } from '../lib/cite.mjs';
import { inline } from '../lib/experiment.mjs';
import { bibtex, citeAs, isoDate, loadWiki, paperLinks, primaryLink, statusLine, venueLine, type Archived, type Paper } from '../lib/wiki';
import PaperLink from './PaperLink.astro';
import PaperPane from './PaperPane.astro';
import Questions from './Questions.astro';

interface Props {
  paper: Paper | Archived;
  /** True for an earlier version of a page, shown from the archive. */
  archived?: boolean;
}

const { paper, archived = false } = Astro.props;
const d = paper.data;
const wiki = await loadWiki();
const { Content, headings: bodyHeadings } = await render(paper);

const concepts = d.concepts.map((id) => wiki.concepts.find((c) => c.id === id)!);
const threads = wiki.threads.filter((t) => d.threads.includes(t.id) || t.data.papers.includes(paper.id));
const cites = wiki.cites.get(paper.id)!.map((id) => wiki.paper.get(id)!);
const citedBy = wiki.citedBy.get(paper.id)!.map((id) => wiki.paper.get(id)!);
// The outline format has no "At a glance". A page has the paper beside it
// wherever the places in the paper have been found (scripts/anchor.mjs): a
// page in the outline format, and the archived page of the same paper, which
// is shown as it was with its locators tied to the paper.
const outline = d.format === 'outline';
const glance = !outline && Boolean(d.questions || d.terms.length || d.setup);
const anchors = outline || archived ? getAnchors(paper.id) : undefined;
const reader = Boolean(anchors && d.links.pdf);
const tied = (html: string) => (anchors ? citeHtml(html, anchors) : html);
const earlier = !archived && wiki.archive.some((a) => a.id === paper.id);
// An archived page stands behind a page that replaced it, or behind a stub still to be written.
const replaced = archived && wiki.paper.get(paper.id)!.data.status === 'full';
const path = `/${archived ? 'archive' : 'papers'}/${paper.id}`;

// The contents list covers the whole page: the sections this template adds
// around the body as well as the body's own headings.
const section = (slug: string, text: string, show = true) => (show ? [{ depth: 2, slug, text }] : []);
const headings = [
  ...section('at-a-glance', 'At a glance', glance),
  ...(glance && d.questions ? [{ depth: 3, slug: 'questions', text: 'Questions and key takeaways' }] : []),
  ...(glance && d.terms.length ? [{ depth: 3, slug: 'key-terms', text: 'Key terms' }] : []),
  ...(glance && d.setup ? [{ depth: 3, slug: 'setup', text: 'The setup' }] : []),
  ...bodyHeadings,
  ...section('threads', 'Threads', threads.length > 0),
  ...section('cites', 'Cites', cites.length > 0),
  ...section('cited-by', 'Cited by', citedBy.length > 0),
  ...section('bibtex', 'BibTeX'),
];
const embeds = /^::post /m.test(paper.body ?? '');

const jsonld = {
  '@type': 'ScholarlyArticle',
  name: d.title,
  headline: d.title,
  author: d.authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: d.date ? isoDate(d.date) : String(d.year),
  ...(d.venue && { isPartOf: { '@type': 'Periodical', name: d.venue } }),
  sameAs: paperLinks(paper).map((l) => l.href),
  url: primaryLink(paper),
  abstract: d.summary,
  citation: cites.map((p) => ({ '@type': 'ScholarlyArticle', name: p.data.title, url: primaryLink(p) })),
};
---

<Base
  title={archived ? `${d.title} (earlier version)` : d.title}
  description={d.summary}
  path={path}
  jsonld={archived ? undefined : jsonld}
  headings={headings}
  embeds={embeds}
  reader={reader}
>
  <article>
    <p class="kicker">Paper · {d.tier}{archived && ' · earlier version'}</p>
    <h1>{d.title}</h1>
    <p class="byline">
      {d.authors.join(', ')} · {venueLine(paper)}
    </p>
    <p class="links">
      {
        paperLinks(paper).map((l, i) => (
          <Fragment>
            {i > 0 && ' · '}
            <a href={l.href}>{l.label}</a>
          </Fragment>
        ))
      }
    </p>
    <p class="lede">{d.summary}</p>
    {
      archived && (
        <p class="draft">
          {replaced ? (
            <Fragment>
              An earlier version of this page, kept as it was. <a href={`/papers/${paper.id}`}>The current page</a> replaced it.
            </Fragment>
          ) : (
            <Fragment>
              This page is in the format the wiki started with and is kept as it was. <a href={`/papers/${paper.id}`}>The paper's page</a> has not yet been written in the current format.
            </Fragment>
          )}
        </p>
      )
    }
    <p class="draft">
      {statusLine(paper)}.{d.sources.length > 0 && ` Written from: ${d.sources.join('; ')}.`}
    </p>
    {
      earlier && (
        <p class="note">
          An <a href={`/archive/${paper.id}`}>earlier version of this page</a>, in the format the wiki started with, is kept as it was.
        </p>
      )
    }

    {
      glance && (
        <section>
          <h2 id="at-a-glance">At a glance</h2>
          {d.questions && (
            <Fragment>
              <h3 id="questions">Questions and key takeaways</h3>
              <Questions root={d.questions} />
            </Fragment>
          )}
          {d.terms.length > 0 && (
            <Fragment>
              <h3 id="key-terms">Key terms, as the paper uses them</h3>
              <table class="card">
                <tbody>
                  {d.terms.map((t) => (
                    <tr>
                      <th scope="row">{t.concept ? <a href={`/concepts/${t.concept}`}>{t.term}</a> : t.term}</th>
                      <td>
                        <Fragment set:html={tied(inline(t.means, {}))} />
                        {t.where && <span class="where" set:html={` ${tied(inline(t.where, {}))}`} />}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Fragment>
          )}
          {d.setup && (
            <Fragment>
              <h3 id="setup">The setup</h3>
              <table class="card">
                <tbody>
                  <tr>
                    <th scope="row">What the model reports on</th>
                    <td>{d.setup.reports_on}</td>
                  </tr>
                  <tr>
                    <th scope="row">Methods</th>
                    <td>{d.setup.methods.join(', ')}</td>
                  </tr>
                  <tr>
                    <th scope="row">Models</th>
                    <td>{d.setup.models.join(', ') || 'n/a'}</td>
                  </tr>
                </tbody>
              </table>
            </Fragment>
          )}
        </section>
      )
    }

    <Content />

    {
      concepts.length > 0 && (
        <p class="note">
          Concepts:{' '}
          {concepts.map((c, i) => (
            <Fragment>
              {i > 0 && ', '}
              <a href={`/concepts/${c.id}`}>{c.data.title}</a>
            </Fragment>
          ))}
        </p>
      )
    }

    {
      threads.length > 0 && (
        <section>
          <h2 id="threads">Threads</h2>
          <ul class="entries">
            {threads.map((t) => (
              <li>
                <a href={`/threads/${t.id}`}>{t.data.title}</a>{' '}
                <span class="meta">@{t.data.author.handle} · {t.data.tweets.length} posts</span>
                <span class="desc">{t.data.summary}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      cites.length > 0 && (
        <section>
          <h2 id="cites">Cites, within this wiki</h2>
          <ul class="entries">
            {cites.map((p) => (
              <li>
                <PaperLink paper={p}>{citeAs(p)}</PaperLink> <span class="meta">{p.data.title}</span>
                <span class="desc">{p.data.summary}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      citedBy.length > 0 && (
        <section>
          <h2 id="cited-by">Cited by, within this wiki</h2>
          <ul class="entries">
            {citedBy.map((p) => (
              <li>
                <PaperLink paper={p}>{citeAs(p)}</PaperLink> <span class="meta">{p.data.title}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <h2 id="bibtex">BibTeX</h2>
    <pre><code>{bibtex(paper)}</code></pre>
  </article>
  {reader && <PaperPane id={paper.id} href={d.links.pdf!} crop={anchors!.crop} />}
</Base>
